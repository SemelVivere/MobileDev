<Page x:Class="EKZ_myself.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EKZ_myself.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1000"
      Title="Продукция"
      FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Background="#00ffff"
                    Orientation="Horizontal"
                    Visibility="Hidden"
                    x:Name="managment">

            <ComboBox x:Name="comboBoxFilter"
                      Width="200"
                      Margin="15"
                      SelectionChanged="cmdFiltr_SelectionChanged"/>

            <ComboBox x:Name="comboBoxSort"
                      Width="200"
                      Margin="15"
                      SelectionChanged="cmdSort_SelectionChanged"/>

            <TextBox x:Name="searchField"
                     Width="200"
                     Margin="15"
                     TextChanged="txtSearch_TextChanged"/>
        </StackPanel>

        <ListView x:Name="listProducts"
                  Grid.Row="1"
                  d:ItemsSource="{d:SampleData ItemCount=3}"
                  HorizontalAlignment="Center">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding ColorAt}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Images}"
                                   Grid.Column="0"
                                   Width="140"
                                   HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        Width="550">
                                <TextBlock FontSize="20">
                                    <Run Text="{Binding CategoryTovar.categorytovar}"/>
                                    <Run Text="|"/>
                                    <Run Text="{Binding name}"/>
                                </TextBlock>
                                
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Описание товара: "/>
                                    <Run Text="{Binding description}"/>
                                </TextBlock>
                                
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding Proizvoditeli.proizvoditeli}"/>
                                </TextBlock>
                                
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Поставщик: "/>
                                    <Run Text="{Binding Postavshik.postavshik}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: "/>
                                    <TextBlock Text="{Binding OldPrice}"
                                               Foreground="Black"/>
                                    <TextBlock Text="{Binding OldPrice}"
                                               Foreground="Red"
                                               TextDecorations="Strikethrough"/>
                                </StackPanel>

                                <TextBlock>
                                    <Run Text="Единицы измерения: "/>
                                    <Run Text="{Binding Edizm.edizm}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding amountstock}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="20"
                                       Background="#00ffff">
                                <Run Text="Действующая скидка: "/>
                                <Run Text="{Binding discount}"/>
                                <Run Text="%"/>
                            </TextBlock>


                        </Grid>
                        
                    </Border>
                    
                </DataTemplate>
                
            </ListView.ItemTemplate>
            
            
        </ListView>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="2">
            <Button Content="Выход"
                    Click="ExitApplication_Button"
                    Width="200"
                    Margin="10"
                    FontSize="15"/>
        </StackPanel>
        
        
    </Grid>
</Page>
