<Page x:Class="EKZ_myself.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EKZ_myself.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage"
      Background="#00ffff"
      FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Логин"
                   FontSize="40"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2"
                   Text="Пароль"
                   FontSize="40"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"/>
        <TextBox Grid.Row="1"
                 x:Name="loginField"
                 Width="300"
                 Height="40"/>
        <PasswordBox Grid.Row="3"
                     x:Name="passwordField"
                     Width="300"
                     Height="40"/>
        <Button Grid.Row="4"
                Width="300"
                Height="40"
                Background="#0000ff"
                Content="Авторизоваться"
                FontSize="30"
                Foreground="White"
                Click="ButtonClick_Authorization"/>
        <Button Grid.Row="5"
                Width="250"
                Height="40"
                Background="#0000ff"
                Content="Войти как гость"
                FontSize="20"
                Foreground="White"
                Click="ButtonClick_GuestEntry"/>
        

    </Grid>
</Page>
